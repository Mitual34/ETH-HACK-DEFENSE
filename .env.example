# Every dashboard setting. Copy to .env and edit. Defaults live in src/config.ts.

# "demo" plays a scripted scenario in the browser; "websocket" reads the ground relay.
VITE_TALOS_SOURCE=demo
# Ground relay WebSocket URL (ws:// or wss://). Required when the source is "websocket".
VITE_TALOS_WS_URL=
# Wait before reconnecting after the relay connection drops, in ms.
VITE_TALOS_RECONNECT_DELAY_MS=1000
# How often the running handover timer redraws, in ms.
VITE_TALOS_TIMER_REFRESH_MS=50
# Event log rows kept on screen.
VITE_TALOS_MAX_LOG_ROWS=200
# Packets longer than this many characters are dropped as malformed.
VITE_TALOS_MAX_MESSAGE_LENGTH=2048
# Events whose reason text is longer than this are dropped as malformed.
VITE_TALOS_MAX_REASON_LENGTH=256
# Events whose node_id is longer than this are dropped as malformed.
VITE_TALOS_MAX_NODE_ID_LENGTH=16
# One console warning is written per this many malformed packets.
VITE_TALOS_MALFORMED_LOG_EVERY=100
# Nodes in the scripted demo scenario.
VITE_TALOS_DEMO_NODE_COUNT=5
# Most cameras opened as feeds. Camera 1 is drone 1, camera 2 is drone 2, and so on.
VITE_TALOS_MAX_FEEDS=4
# Fewest feeds on screen; missing cameras are filled with placeholders.
VITE_TALOS_MIN_FEEDS=2
# Resolution requested from each camera. Lower it if two USB cameras will not open together.
VITE_TALOS_FEED_WIDTH=1280
VITE_TALOS_FEED_HEIGHT=720
# Longest wait for the first frame of a switched feed before giving up, in ms.
VITE_TALOS_FRAME_TIMEOUT_MS=1000
